{
  "name": "wa-dashboard-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "WhatsApp automation dashboard backend (Node.js + Baileys)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsc && node dist/index.js",
    "dev": "tsc --watch",
