# Server binding — keep 127.0.0.1 to restrict access to this device only.
# Change to 0.0.0.0 ONLY if you understand the security implications.
HOST=127.0.0.1
PORT=3456

# Directory where sessions, store and logs are persisted.
# On Termux use an absolute path, e.g. /data/data/com.termux/files/home/wa-data
DATA_DIR=./data

# Optional: pre-set the dashboard API token. If unset, one is generated
# on first start and printed to the console / stored in the data directory.
# API_TOKEN=change-me-to-a-long-random-string
